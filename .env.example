# Скопируйте в .env и заполните значения. Не коммитьте .env с секретами.

# Dev-only payment mocks (POST /api/payments/mock + YooKassa auth-fail fallbacks).
# Leave unset/false on production.
# ENABLE_PAYMENT_MOCK=true

# Play RU payment gate: deny YooKassa create outside allowlist when enforce=true.
# Production: PAYMENTS_GEO_ENFORCE=true
# PAYMENTS_GEO_ENFORCE=true
# PAYMENTS_ALLOWED_COUNTRIES=RU
# Tests / staging override (skip ip-api): PAYMENTS_GEO_FORCE_COUNTRY=RU

# YouTube → MP3 (по умолчанию локально: yt-dlp + FFmpeg, как yt-audio-api)
# https://github.com/alperensumeroglu/yt-audio-api
YOUTUBE_AUDIO_PROVIDER=ytdlp
YOUTUBE_YTDLP_MP3_QUALITY=192
YOUTUBE_TMP_DIR=uploads/youtube_tmp
# Прокси для yt-dlp с VPS в РФ. Предпочтительно socks5h:// (DNS через прокси).
# socks5:// без h авто-апгрейдится до socks5h в youtube_converter.py
# YTDLP_PROXY=socks5h://127.0.0.1:10801
# Опционально cookies (Netscape) — для age-restricted / "Sign in to confirm your age"
# YTDLP_COOKIES_FILE=/var/www/sounduk_backend/secrets/youtube_cookies.txt
YOUTUBE_IMPORT_MAX_ITEMS=200
YOUTUBE_IMPORT_BATCH_SIZE=10
YOUTUBE_IMPORT_CONCURRENCY=10
MAX_ACTIVE_IMPORT_JOBS_PER_USER=10
# IMPORT_ITEM_STALE_RUNNING_MINUTES=45

# Стриминг: прямые presigned URL на S3 (обязательно, если VPS не проксирует Selectel S3)
STREAM_PRESIGNED_ENABLED=true
STREAM_PRESIGNED_TTL=1800

# Опционально RapidAPI (если YOUTUBE_AUDIO_PROVIDER=rapidapi)
# RAPIDAPI_KEY=your_rapidapi_key_here
# YOUTUBE_MP3_HOST=youtube-mp310.p.rapidapi.com
# YOUTUBE_MP3_PATH=/download/mp3
